@model List<Movie>

@{
    ViewData["Title"] = "Все фильмы";
}

<h2>Каталог фильмов</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-7">
        <input type="search" name="query" value="@ViewData["Query"]" class="form-control" placeholder="Поиск по названию">
    </div>
    <div class="col-md-3">
        <input type="search" name="genre" value="@ViewData["Genre"]" class="form-control" placeholder="Жанр">
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Найти</button>
    </div>
</form>

<div class="row">
    @if (Model.Count == 0)
    {
        <div class="col-12">
            <div class="alert alert-info">Фильмы пока не загружены или ничего не найдено.</div>
        </div>
    }

    @foreach (var movie in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@movie.Title (@movie.Year)</h5>
                    <p class="card-text"><strong>Жанр:</strong> @movie.Genre</p>
                    <p class="card-text">@movie.Description</p>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("Rate", "Movie", new { movieId = movie.Id })"
                           class="btn btn-primary">Оценить фильм</a>

                        <div class="rating-info">
                            <small class="text-muted">Нажмите чтобы поставить оценку</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
