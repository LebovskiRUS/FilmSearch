@model MovieFormViewModel

@{
    ViewData["Title"] = "Редактирование фильма";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <h2>Редактирование фильма</h2>

        <form method="post" action="@Url.Action("EditMovie", "Admin")" class="mt-4">
            <partial name="_MovieForm" model="Model" />

            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">Назад</a>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </div>
        </form>
    </div>
</div>
