@model AdminMoviesViewModel

@{
    ViewData["Title"] = "Администрирование";
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <h2>Администрирование</h2>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Импорт MovieLens 1M</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("ImportMovieLens", "Admin")">
                    <div class="mb-3">
                        <label for="datasetDirectory" class="form-label">Папка с датасетом</label>
                        <input type="text"
                               class="form-control"
                               id="datasetDirectory"
                               name="datasetDirectory"
                               value="@Model.DefaultDatasetDirectory"
                               placeholder="C:\Datasets\ml-1m"
                               required>
                        <div class="form-text">В папке должны быть файлы users.dat, movies.dat и ratings.dat.</div>
                    </div>

                    <button type="submit" class="btn btn-primary">Запустить импорт</button>
                </form>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Добавить фильм</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("CreateMovie", "Admin")">
                    <partial name="_MovieForm" model="Model.NewMovie" />
                    <button type="submit" class="btn btn-success">Добавить</button>
                </form>
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                <h5 class="mb-0">Фильмы</h5>
                <form method="get" class="d-flex gap-2">
                    <input type="search" name="query" value="@Model.Query" class="form-control" placeholder="Поиск">
                    <button type="submit" class="btn btn-outline-primary">Найти</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Год</th>
                            <th>Жанры</th>
                            <th>Оценки</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Movies.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-muted">Фильмы не найдены.</td>
                            </tr>
                        }

                        @foreach (var movie in Model.Movies)
                        {
                            <tr>
                                <td>@movie.Title</td>
                                <td>@movie.Year</td>
                                <td>@movie.Genre</td>
                                <td>@movie.AverageRating (@movie.RatingsCount)</td>
                                <td class="text-end">
                                    <a href="@Url.Action("EditMovie", "Admin", new { id = movie.Id })" class="btn btn-sm btn-outline-primary">Редактировать</a>
                                    <form method="post" action="@Url.Action("DeleteMovie", "Admin")" class="d-inline">
                                        <input type="hidden" name="id" value="@movie.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
