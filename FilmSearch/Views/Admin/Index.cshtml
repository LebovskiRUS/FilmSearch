@model List<Movie>

@{
    ViewData["Title"] = "Администрирование";
    var defaultDatasetDirectory = ViewData["DefaultDatasetDirectory"] as string ?? string.Empty;
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <h2>Администрирование</h2>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Импорт MovieLens 1M</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("ImportMovieLens", "Admin")">
                    <div class="mb-3">
                        <label for="datasetDirectory" class="form-label">Папка с датасетом</label>
                        <input type="text"
                               class="form-control"
                               id="datasetDirectory"
                               name="datasetDirectory"
                               value="@defaultDatasetDirectory"
                               placeholder="C:\Datasets\ml-1m"
                               required>
                        <div class="form-text">В папке должны быть файлы users.dat, movies.dat и ratings.dat.</div>
                    </div>

                    <button type="submit" class="btn btn-primary">Запустить импорт</button>
                </form>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Добавить фильм</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("CreateMovie", "Admin")">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="title" class="form-label">Название</label>
                            <input type="text" class="form-control" id="title" name="title" maxlength="300" required>
                        </div>
                        <div class="col-md-2">
                            <label for="year" class="form-label">Год</label>
                            <input type="number" class="form-control" id="year" name="year" min="1888" max="2100">
                        </div>
                        <div class="col-md-4">
                            <label for="genres" class="form-label">Жанры</label>
                            <input type="text" class="form-control" id="genres" name="genres" maxlength="200" placeholder="Drama|Comedy" required>
                        </div>
                        <div class="col-md-6">
                            <label for="imageUrl" class="form-label">URL обложки</label>
                            <input type="url" class="form-control" id="imageUrl" name="imageUrl" maxlength="500">
                        </div>
                        <div class="col-md-6">
                            <label for="description" class="form-label">Описание</label>
                            <textarea class="form-control" id="description" name="description" rows="1"></textarea>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success mt-3">Добавить</button>
                </form>
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                <h5 class="mb-0">Фильмы</h5>
                <form method="get" class="d-flex gap-2">
                    <input type="search" name="query" value="@ViewData["Query"]" class="form-control" placeholder="Поиск">
                    <button type="submit" class="btn btn-outline-primary">Найти</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Год</th>
                            <th>Жанры</th>
                            <th>Оценки</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-muted">Фильмы не найдены.</td>
                            </tr>
                        }

                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td>@movie.Title</td>
                                <td>@movie.Year</td>
                                <td>@movie.Genre</td>
                                <td>@movie.AverageRating (@movie.RatingsCount)</td>
                                <td class="text-end">
                                    <a href="@Url.Action("EditMovie", "Admin", new { id = movie.Id })" class="btn btn-sm btn-outline-primary">Редактировать</a>
                                    <form method="post" action="@Url.Action("DeleteMovie", "Admin")" class="d-inline">
                                        <input type="hidden" name="id" value="@movie.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
